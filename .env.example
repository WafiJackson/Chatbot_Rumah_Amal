# =====================================================================
# CONFIGURATION ENVIRONMENT FILE (BOT RUMAH AMAL USK - DOCKER DEPLOYMENT)
# =====================================================================

# 1. Supabase Cloud Configuration (Opsional - Jika kosong, bot otomatis fallback ke SQLite lokal)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# 2. WAHA WhatsApp Gateway Configuration
WAHA_ENDPOINT=http://waha-gateway:3000
WAHA_API_KEY=secret

# 2b. Secret endpoint /webhook - WAJIB diisi, generate dengan:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
# Tanpa ini, siapa saja yang tahu URL /webhook bisa mengirim payload palsu.
WEBHOOK_SECRET=

# 3. Google Gemini LLM Configuration (wajib diisi - dipakai untuk Q&A, NER, dan OCR resi)
GEMINI_API_KEY=your-gemini-api-key
MODEL_NAME=gemini-2.5-flash

# 4. Admin WhatsApp Official Contact (Untuk Alert Notifikasi PINTAS/BPRA-UKT)
ADMIN_WA_NUMBER=62xxxxxxxxxxx@c.us

# 5. Admin Dashboard Login (/admin) - wajib diisi salah satu password di bawah
#    sebelum deploy.
ADMIN_DASHBOARD_USERNAME=admin
#    DIANJURKAN: isi ADMIN_DASHBOARD_PASSWORD_HASH (bukan plaintext), generate
#    dengan perintah ini (ganti "password-anda" dulu):
#      python -c "import sys; sys.path.insert(0,'app'); from routes.admin_web import hash_password; print(hash_password('password-anda'))"
#    lalu hapus/kosongkan ADMIN_DASHBOARD_PASSWORD di bawah.
ADMIN_DASHBOARD_PASSWORD_HASH=
#    Alternatif (kurang aman - password tersimpan apa adanya di file ini):
ADMIN_DASHBOARD_PASSWORD=your-strong-password-here
